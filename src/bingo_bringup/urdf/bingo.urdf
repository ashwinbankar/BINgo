<?xml version="1.0" encoding="utf-8"?>
<robot name="bingo">

  <!-- ROS 2 Standard Root Frame (FLU: +X Forward, +Y Left, +Z Up) -->
  <link name="base_link"/>

  <!-- Rotate SolidWorks Y-up/Z-right chassis into ROS Z-up/Y-left -->
  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="Chassis_link"/>
    <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
  </joint>

  <!-- IMU Frame (GY-521 / MPU-6050) — update xyz with measured mounting offset -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.085" rpy="0 0 0"/>
  </joint>

  <!-- RPLIDAR A1 Frame (matches frame_id:=laser in pi/run_lidar.sh) -->
  <link name="laser"/>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.0 0.0 0.11192" rpy="0 0 0"/>
  </joint>

  <link name="Chassis_link">
    <inertial>
      <origin xyz="-5.0647E-05 0.054223 3.6227E-06" rpy="0 0 0"/>
      <mass value="1.5726"/>
      <inertia ixx="0.0072629" ixy="1.4163E-07" ixz="6.3601E-07"
               iyy="0.016111" iyz="-8.8671E-09" izz="0.0091389"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/Chassis_link.STL"/>
      </geometry>
      <material name="chassis_grey">
        <color rgba="0.89412 0.89412 0.89412 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/Chassis_link.STL"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="4.9027E-05 -2.1678E-06 0.0089707" rpy="0 0 0"/>
      <mass value="0.1238"/>
      <inertia ixx="2.3671E-05" ixy="-3.4081E-11" ixz="-4.7721E-13"
               iyy="2.3671E-05" iyz="-2.4063E-12" izz="3.1205E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/front_left_wheel_link.STL"/>
      </geometry>
      <material name="wheel_grey">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/front_left_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <origin xyz="0.08884 0.02032 -0.13959" rpy="0 0 0"/>
    <parent link="Chassis_link"/>
    <child link="front_left_wheel_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="4.7975E-05 -1.0332E-05 -0.0089707" rpy="0 0 0"/>
      <mass value="0.1238"/>
      <inertia ixx="2.3671E-05" ixy="-7.661E-11" ixz="-1.7968E-13"
               iyy="2.3671E-05" iyz="-2.4774E-12" izz="3.1205E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/front_right_wheel_link.STL"/>
      </geometry>
      <material name="wheel_grey">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/front_right_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <origin xyz="0.08884 0.02032 0.1396" rpy="0 0 0"/>
    <parent link="Chassis_link"/>
    <child link="front_right_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="back_left_wheel_link">
    <inertial>
      <origin xyz="4.8276E-05 8.8186E-06 0.0089707" rpy="0 0 0"/>
      <mass value="0.1238"/>
      <inertia ixx="2.3671E-05" ixy="6.3537E-11" ixz="9.3507E-14"
               iyy="2.3671E-05" iyz="-2.4816E-12" izz="3.1205E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/back_left_wheel_link.STL"/>
      </geometry>
      <material name="wheel_grey">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/back_left_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_left_wheel_joint" type="continuous">
    <origin xyz="-0.08896 0.02032 -0.13959" rpy="0 0 0"/>
    <parent link="Chassis_link"/>
    <child link="back_left_wheel_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="back_right_wheel_link">
    <inertial>
      <origin xyz="4.6914E-05 -1.4403E-05 -0.0089707" rpy="0 0 0"/>
      <mass value="0.1238"/>
      <inertia ixx="2.3671E-05" ixy="-1.1057E-10" ixz="-4.0162E-13"
               iyy="2.3671E-05" iyz="-2.4513E-12" izz="3.1205E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/back_right_wheel_link.STL"/>
      </geometry>
      <material name="wheel_grey">
        <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/back_right_wheel_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="back_right_wheel_joint" type="continuous">
    <origin xyz="-0.08896 0.02032 0.1396" rpy="0 0 0"/>
    <parent link="Chassis_link"/>
    <child link="back_right_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.01" friction="0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/lidar_link.STL"/>
      </geometry>
      <material name="lidar_white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bingo_bringup/meshes/lidar_link.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="1.29147676376506E-05 0.111919999999918 -5.52029835741985E-05" rpy="0 0 0"/>
    <parent link="Chassis_link"/>
    <child link="lidar_link"/>
    <axis xyz="0 0 0"/>
  </joint>

</robot>